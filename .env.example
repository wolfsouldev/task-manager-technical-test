# API local: copiar a apps/api/.env. SQLite por defecto, sin servidor adicional.
DATABASE_URL=file:./data/tasks.db
# PostgreSQL: sustituir DATABASE_URL por la URL de una BD existente.
# DATABASE_URL=postgresql://task_manager:password@localhost:5432/task_manager
# TLS: añadir ?sslmode=verify-full a la URL si el servidor lo requiere.
# Docker Compose lee .env en la raíz: para SQLite usar file:/app/data/tasks.db;
# para PostgreSQL indicar un host accesible desde el contenedor (no localhost).
PORT=3000
